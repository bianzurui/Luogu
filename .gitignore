
# =========================
# C语言编译生成文件
# =========================

# Windows 可执行文件
*.exe
*.dll

# 编译中间文件
*.o
*.obj
*.a
*.lib

# GCC / Clang 输出文件
*.out

# 调试文件
*.pdb
*.ilk
*.idb
*.dSYM/

# =========================
# 编译和构建目录
# =========================

build/
bin/
obj/

# =========================
# VS Code 临时文件
# =========================

.vscode/ipch/
.vscode/*.log

# =========================
# 系统临时文件
# =========================

.DS_Store
Thumbs.db
*.tmp
*.temp
# 忽略洛谷题目编译生成的无扩展名文件
/p[0-9]*
!/p[0-9]*.c